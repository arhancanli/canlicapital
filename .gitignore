.vercel
node_modules
dist
*.log
.DS_Store

# Local credentials and runtime configuration. Never publish broker or deployment secrets.
.env*
!.env.example

# Playwright/render-audit output — regenerated on every run, never source.
test-results/
artifacts/qa/visual/*.png
artifacts/qa/visual/lighthouse-*.json
artifacts/qa/advisor-homepage/lighthouse.json
artifacts/qa/advisor-homepage/lighthouse-mobile.json
artifacts/qa/advisor-homepage/lighthouse-accessibility.json

# Deterministic public claim bundle. Built from the tracked registry and current
# glass-box artifacts during prebuild, then copied into dist by Vite.
public/contracts/public-claims.json

# Phase snapshots kept locally while the redesign landed. History lives in git now.
.bak/

# Local agent tooling config — not part of the published site.
.claude/

# Local agent tooling and CLI scratch state, never part of the site.
.claude-flow/
ruvector.db
supabase/.temp/
__pycache__/

# design-system/ (canli-design-system, the React wrapper package for Claude Design sync) and
# its Claude Design converter staging area: build output and installed dependencies are
# regenerated, never source.
design-system/node_modules/
design-system/dist/
# Byte-for-byte copy of ../../scripts/product-shell.mjs, written fresh by
# design-system/scripts/build.mjs on every build. See .design-sync/NOTES.md item 3.
design-system/src/shell/generated-product-shell.mjs
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# SEC source responses are published as hash-addressed gzip snapshots.
artifacts/seo/sec-source/
