      "body_sha256": "86f8c9f2629dd5a5e3211b808a2e64fa3fbd03b148bd95ce53d0352370ff92f5",
      "section_bytes": 515
    },
    {
      "name": "expert client native: one false nativewrite resolves on one drain without retry and preserves SDK Promise completion",
      "line": 714,
      "body_sha256": "789180578288ad2b0b66485441307f28912a19c73b85510576d7ce00e7210325",
      "section_bytes": 418
    },
    {
      "name": "expert client native: writer failure has no second write and still memoizes original child transportclose exactly once",
      "line": 718,
      "body_sha256": "3317ad376ca1825c7e73fa46fe7b31e242bdaf7807694e70cf943ac09b79b298",
      "section_bytes": 439
    },
    {
      "name": "expert client native: queued late callback stops at same sender boundary rather than issuing a followup audit",
      "line": 722,
      "body_sha256": "ce953e78851dd5f99045fae43f1dc4f8f259d1f973051d2ad6723d68d4dfa2b4",
      "section_bytes": 421
    },
    {
      "name": "expert client native: synchronous compiler exhaustion owns a later task rejection before postcallback clock refusal",
      "line": 726,
      "body_sha256": "ec85855de2572444dde5af086414c1631a511df2a66d87e0e03188826317e446",
      "section_bytes": 731
    },
    {
      "name": "expert client native: immediate and delayed originalSTART rejections stay owned when subsequent PID admission throws",
      "line": 734,
      "body_sha256": "06a2354f923e5d4f0305b756a57b8f1677fb4ac458afceb8a89953f664f90458",
      "section_bytes": 906
    },
    {
      "name": "expert client native: same original pending task rejection after queued return is consumed without hidden retry or second call",
      "line": 744,
      "body_sha256": "40334c9e1bed8f191aa5a1447747962b7b12b1e0b285aa4d1c6b4c74cc5b7929",
      "section_bytes": 472
    },
    {
      "name": "expert client native: connect refusal closes the exact known child and never starts an audit",
      "line": 748,
      "body_sha256": "64c3d3dc2d7215d1739b7e85379e80d6e0bdbab9bbc2c63ce4afe6862f2463a7",
      "section_bytes": 383
    },
    {
      "name": "expert client native: rehashed gold and submission binding tampering is refused beyond self-consistent content_hash",
      "line": 752,
      "body_sha256": "f06b9f3edece5a60b25a112229442651dca221e72d19a5f3ae1e84c4b5d22c50",
      "section_bytes": 5652
    },
    {
      "name": "expert client native: rehashed reduced selectedN or missing-pair denominator is refused while full originals remain intact",
      "line": 814,
      "body_sha256": "4969ae7abe32221646ea542c0b694f16c7a324080c97e5d48e5ad71fe37a0ca0",
      "section_bytes": 464
    },
    {
      "name": "expert client native: rehashed promoted human rights and declared-source flags never become verified outcomes",
      "line": 820,
      "body_sha256": "0fc84e94b4c5331b4776ce5a1301e82ffd2c0e8febf952cf659c5d96537348fe",
      "section_bytes": 685
    },
    {
      "name": "expert client native: structured-text mismatch duplicate text keys and rehashed changed returned notes cannot lose companions",
      "line": 826,
      "body_sha256": "2b9f2ef9286becdb8e326a121915b6625a7485f28575be0e368aca061088ed1f",
      "section_bytes": 820
    },
    {
      "name": "expert client native: complete escaped request cap and whole duplicated result cap refuse before wire or report persistence",
      "line": 832,
      "body_sha256": "af76d945bec52e2140f7711febcfece38e1f20837646846fba485ab6e35e7990",
      "section_bytes": 668
    },
    {
      "name": "expert client native: missing known-owned absence or exhausted close reserve cannot mark an output success",
      "line": 839,
      "body_sha256": "d92a5909652150b7f067aaf007c0d9a7ac4e0e66f86f75e45af03fb7230d2d0a",
      "section_bytes": 852
    },
    {
      "name": "expert client native: existing output and nonprivate parent refuse before any SDK child without overwrite or permission repair",
      "line": 847,
      "body_sha256": "cce72eb29085bc3f13d735449a9fda61cd85f867390fd300068fbad383bf007a",
      "section_bytes": 642
    },
    {
      "name": "expert client native: uncertain short output followed by write failure retains the private partial file and no success",
      "line": 854,
      "body_sha256": "cab513be586c519bb4594dd6c2fea2c023f24e719fbd2ccd605543cea0092bad",
      "section_bytes": 792
    },
    {
      "name": "expert client native: fsync and sameFD readback uncertainty retain the complete file and refuse without a second output",
      "line": 860,
      "body_sha256": "8efb6a56e19a5c3abf6e0ac73eb85105611286e6c1b64faf8a59f871e2b97a95",
      "section_bytes": 882
    },
    {
      "name": "expert client native: post-readback path replacement and directory flush failure preserve uncertainty and retained outputs",
      "line": 868,
      "body_sha256": "2c783abc6f24d648a8d8428d95e87851704135fd069c24a8b0a9ed574037ed5e",
      "section_bytes": 1277
    },
    {
      "name": "expert client native: output close-after-close descriptor reuse is not retried and the durable report stays retained",
      "line": 878,
      "body_sha256": "5280532c0ee31229626086efb1a3ebc7d338c49351270e54f3c21872518c3f76",
      "section_bytes": 1389
    },
    {
      "name": "expert client native: postserialization terminal clock refusal has zero native terminal writes and no echoed private exception",
      "line": 890,
      "body_sha256": "f752057172ee9a4ed445236b33d90a5d3ee89badcf858c6b4165a21774439555",
      "section_bytes": 743
    },
    {
      "name": "expert client package: marked guide direct entry1 uses the same six input buffers and one known closed SDK child",
      "line": 897,
      "body_sha256": "589a4c54edec3b74c57bb977ff8b95ceda178d81dca87d12fe76daa588b88d5c",
      "section_bytes": 191
    },
    {
      "name": "expert client package: owned absolute bin alias entry2 returns byteexact full report with one known closed SDK child",
      "line": 898,
      "body_sha256": "4c963cd6ded41a5672ad69b076d085f3907798b4cc33b1cdde1470c3f2209ae4",
      "section_bytes": 195
    },
    {
      "name": "expert client package: complete invalid tool batch entry3 has a stable tiny refusal one call and known owned closure",
      "line": 899,
      "body_sha256": "c8d3643a1aec5dd11914718a9cde5ad93fac6669835df0fa901aff6e289f6bc3",
      "section_bytes": 197
    },
    {
      "name": "expert client native: terminal listener-admission abort and nonfinite or backwards clocks cannot issue success",
      "line": 900,
      "body_sha256": "b81c83aa77dd01568e7d7f8b1a121afc4f41d5119e4f8a633188d974e8cabb98",
