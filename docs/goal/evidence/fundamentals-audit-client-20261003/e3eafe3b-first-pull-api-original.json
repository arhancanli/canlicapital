g, deadlines, backpressure and closure. Three cases use the locked SDK; the remaining cases inject native controls. Existing default tools, core, package members, dependencies, versions and root verify are preserved.\n\nValidation: signed source e3eafe3b; its automatic remote CI and independent source/evidence reviews are pending.\n","created_at":"2026-10-03T11:57:36Z","updated_at":"2026-10-03T12:59:04Z","closed_at":null,"merged_at":null,"merge_commit_sha":"a16408486d01c456a8701c82c246a701fcd0ba85","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":true,"commits_url":"https://api.github.com/repos/arhancanli/canlicapital/pulls/371/commits","review_comments_url":"https://api.github.com/repos/arhancanli/canlicapital/pulls/371/comments","review_comment_url":"https://api.github.com/repos/arhancanli/canlicapital/pulls/comments{/number}","comments_url":"https://api.github.com/repos/arhancanli/canlicapital/issues/371/comments","statuses_url":"https://api.github.com/repos/arhancanli/canlicapital/statuses/e3eafe3b70b92d6f84267b35cb15633766fbbcf1","head":{"label":"arhancanli:assist/fundamentals-audit-client-20261003","ref":"assist/fundamentals-audit-client-20261003","sha":"e3eafe3b70b92d6f84267b35cb15633766fbbcf1","user":{"login":"arhancanli","id":315329124,"node_id":"U_kgDOEsuKZA","avatar_url":"https://avatars.githubusercontent.com/u/315329124?v=4","gravatar_id":"","url":"https://api.github.com/users/arhancanli","html_url":"https://github.com/arhancanli","followers_url":"https://api.github.com/users/arhancanli/followers","following_url":"https://api.github.com/users/arhancanli/following{/other_user}","gists_url":"https://api.github.com/users/arhancanli/gists{/gist_id}","starred_url":"https://api.github.com/users/arhancanli/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arhancanli/subscriptions","organizations_url":"https://api.github.com/users/arhancanli/orgs","repos_url":"https://api.github.com/users/a