    "/api/v1/status": {
      "get": {
        "summary": "Current state of the paper record: capital kind, period, observation count, validation status and broker reconciliation.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "The current snapshot, regenerated on each publish.",
