    "/api/v1/keys": {
      "post": {
        "summary": "Issue a free key. Returned once; only its hash is stored.",
        "operationId": "keys",
        "responses": {
          "201": {
            "description": "The key, once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "405": {
            "description": "Wrong method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "413": {
            "description": "Body over 1048576 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Input the validator refuses, with the reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "At most 5 keys per client per day",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "label": "my-backtest-runner"
              }
            }
          }
        }
      }
    },
    "/api/v1/validate/deflated-sharpe": {
      "post": {
        "summary": "Probabilistic and deflated Sharpe from the seven contract inputs, or from a return series plus the trials behind it.",
        "operationId": "validate_deflated_sharpe",
        "responses": {
          "200": {
            "description": "The envelope with data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "405": {
            "description": "Wrong method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "413": {
            "description": "Body over 1048576 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Input the validator refuses, with the reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "Daily quota of 1000 validations reached; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "returns": [
                  0.004,
                  -0.002,
                  0.007,
                  0.001,
                  -0.003,
                  0.005,
                  0.002,
                  -0.001
                ],
                "periods_per_year": 252,
                "effective_independent_trials": 30,
                "cross_trial_sharpe_sd_annualized": 0.5
              }
            }
          }
        },
        "security": [
          {
            "bearerKey": []
          }
        ]
      }
    },
    "/api/v1/validate/overfitting": {
      "post": {
        "summary": "Probability of backtest overfitting by CSCV over the returns of every variant tried.",
        "operationId": "validate_overfitting",
