              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "matrix": [
                  [
                    0.01,
                    0.002,
                    -0.004
                  ],
                  [
                    -0.003,
                    0.001,
                    0.006
                  ],
                  [
                    0.004,
                    -0.002,
                    0.001
                  ],
                  [
                    0.002,
                    0.003,
                    -0.001
                  ]
                ],
                "n_splits": 4
              }
            }
          }
        },
        "security": [
          {
            "bearerKey": []
          }
        ]
      }
    },
