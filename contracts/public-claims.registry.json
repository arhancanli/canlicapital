{
  "schema": "canli.public-claim-registry.v1",
  "contract_version": "1.0.0",
  "claim_boundary": "This registry identifies public claims and their current evidence sources. A resolved value inherits its maturity and limitation. Resolution does not establish performance, independent validation or future results.",
  "claims": [
    {
      "id": "forward.capital-kind",
      "label": "Record basis",
      "description": "Capital basis of the published forward record.",
      "maturity": "observed",
      "value_type": "string",
      "format": "status",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/forward_record/capital_kind", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "status", "open"]
    },
    {
      "id": "forward.first-mark",
      "label": "Paper record start",
      "description": "First published mark in the current forward record.",
      "maturity": "observed",
      "value_type": "string",
      "format": "date",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/forward_record/first_mark", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "status"]
    },
    {
      "id": "forward.last-mark",
      "label": "Latest paper mark",
      "description": "Most recent published mark in the current forward record.",
      "maturity": "observed",
      "value_type": "string",
      "format": "date",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/forward_record/last_mark", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "status"]
    },
    {
      "id": "forward.live-days",
      "label": "Paper-trading days",
      "description": "Calendar days since the declared paper record began.",
      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "calendar days",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/forward_record/live_days", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "status"]
    },
    {
      "id": "forward.return-observations",
      "label": "Daily return observations",
      "description": "Return observations available for forward Sharpe estimation.",
      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "daily returns",
      "source": {"path": "/glassbox/forward_evidence_maturity.json", "pointer": "/record/daily_return_observations", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "methodology", "status"]
    },
    {
      "id": "forward.cumulative-return",
      "label": "Forward cumulative return",
      "description": "Cumulative return of the normalized composite paper record.",
      "maturity": "observed",
      "value_type": "number",
      "format": "percent",
      "unit": "decimal return",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/forward_record/cumulative_return", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "status"]
    },
    {
      "id": "forward.validation-status",
      "label": "Program validation status",
      "description": "Current status under the forward evidence contract.",
      "maturity": "observed",
      "value_type": "string",
      "format": "status",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/achievement/overall", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "methodology", "status"]
    },
    {
      "id": "broker.reconciled-alpaca-sleeves",
