      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "orders",
      "source": {"path": "/glassbox/alpaca_broker_reconciliation.json", "pointer": "/summary/open_orders", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "status"]
    },
    {
      "id": "objective.forward-sharpe",
      "label": "Forward Sharpe objective",
      "description": "Prospective forward Sharpe objective for the ALPHAC portfolio.",
      "maturity": "planned",
      "value_type": "number",
      "format": "decimal",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/objective/honest_forward_sharpe_target", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "methodology", "status"]
    },
    {
      "id": "objective.expected-max-drawdown",
      "label": "Expected maximum drawdown objective",
      "description": "Portfolio objective for expected maximum drawdown.",
      "maturity": "planned",
      "value_type": "number",
      "format": "percent",
      "unit": "decimal drawdown",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/objective/portfolio_max_drawdown_target", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "methodology", "status"]
    },
    {
      "id": "model.expected-max-drawdown",
      "label": "Modeled expected maximum drawdown",
      "description": "Conservative risk-model estimate for the current composition.",
      "maturity": "model_estimated",
