      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "paper sleeves",
      "source": {"path": "/glassbox/alpaca_broker_reconciliation.json", "pointer": "/summary/reconciled_alpaca_sleeves", "as_of_pointer": "/generated_at"},
