    {
      "id": "broker.reconciliation-passes",
      "label": "Broker reconciliation",
      "description": "Whether the latest self-published broker reconciliation passes.",
      "maturity": "observed",
      "value_type": "boolean",
      "format": "status",
      "source": {"path": "/glassbox/alpaca_broker_reconciliation.json", "pointer": "/summary/passes", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "verify", "status"]
    },
    {
      "id": "broker.open-positions",
      "label": "Broker positions",
      "description": "Open positions across reconciled Alpaca paper sleeves.",
      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "positions",
