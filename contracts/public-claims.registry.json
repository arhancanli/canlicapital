      "format": "percent",
      "unit": "decimal drawdown",
      "source": {"path": "/glassbox/current_book_drawdown.json", "pointer": "/objective/conservative_modeled_p95_max_drawdown"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "methodology", "status"]
    },
    {
      "id": "sleeves.current",
      "label": "Current sleeves",
      "description": "Current sleeves in the published ALPHAC composition.",
      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "sleeves",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/achievement/current_sleeves", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "foundry", "status"]
    },
    {
      "id": "sleeves.target",
      "label": "Sleeve breadth objective",
      "description": "Maximum governed architecture objective for portfolio breadth.",
      "maturity": "planned",
      "value_type": "integer",
      "format": "count",
      "unit": "sleeves",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/objective/target_total_sleeves", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "systems", "foundry", "methodology", "status"]
    },
    {
      "id": "diversification.average-pairwise-correlation",
      "label": "Research-window average correlation",
      "description": "Average pairwise correlation for the current research composition.",
      "maturity": "simulated",
      "value_type": "number",
      "format": "decimal",
      "source": {"path": "/glassbox/current_book_diversification.json", "pointer": "/observed/average_pairwise_correlation"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "live", "systems", "methodology", "status"]
    },
    {
      "id": "objective.average-pairwise-correlation",
      "label": "Average correlation objective",
      "description": "Planning objective for average pairwise sleeve correlation.",
      "maturity": "planned",
      "value_type": "number",
      "format": "decimal",
      "source": {"path": "/glassbox/program_status.json", "pointer": "/objective/average_pairwise_correlation_objective", "as_of_pointer": "/generated_at"},
      "boundary": {"pointer": "/claim_boundary"},
      "surfaces": ["home", "systems", "foundry", "methodology", "status"]
    },
    {
      "id": "research.identities-observed",
      "label": "Observed trial identities",
      "description": "Hypothesis identities currently charged to the complete trial union.",
      "maturity": "observed",
      "value_type": "integer",
      "format": "count",
      "unit": "trial identities",
      "source": {"path": "/glassbox/trial_accounting.json", "pointer": "/observed_hypothesis_identities", "as_of_pointer": "/accounting_last_reconciled"},
      "boundary": {"text": "This is the observed complete-union identity count. It does not measure strategy quality or permit additional testing beyond the active budget and tripwires."},
      "surfaces": ["research", "trials", "foundry", "methodology", "status"]
    },
    {
      "id": "research.identity-budget",
      "label": "Trial identity ceiling",
      "description": "Current maximum authorized hypothesis identity budget.",
      "maturity": "planned",
      "value_type": "integer",
      "format": "count",
      "unit": "trial identities",
      "source": {"path": "/glassbox/trial_accounting.json", "pointer": "/hypothesis_identity_budget", "as_of_pointer": "/budget_last_reviewed"},
      "boundary": {"text": "This ceiling is permission to test, not permission to admit a sleeve. Reaching it without enough admissions is a result and does not authorize a larger search."},
      "surfaces": ["research", "trials", "foundry", "methodology", "status"]
    }
  ]
}
