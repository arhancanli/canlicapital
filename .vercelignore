# What the deploy uploads is what the build needs, nothing else. On 2026-09-06 the upload hit
# Vercel's 15,000-file cap (15,005) because three agent worktrees under .claude/ and the local
# dist/ rode along, and the landing deploy failed three times. Vercel rebuilds dist/ itself.
.claude
.claude-flow
.env*
.vercel
.git
node_modules
ruvector.db
.bak
.firecrawl
.github
dist
test-results
# Build-time route inventory is required by the reader and release generators.
# Keep every other QA output (especially browser screenshots) out of uploads.
artifacts/qa/*
!artifacts/qa/redesign-scope
artifacts/qa/redesign-scope/*
!artifacts/qa/redesign-scope/inventory.json
# Render sources, reference captures and tool binaries are local authoring inputs.
# Shippable imagery and films already live in public/.
artifacts/generated
artifacts/production
artifacts/reference
artifacts/seo
artifacts/toolchain
artifacts/tooling
docs
supabase
**/*.test.mjs
**/*.test.js
integrations
# mcp/ is a separate package, but the developers page generator reads its README and package.json
# at build time (the assistant block and the published version), so those two stay in the upload.
mcp/*
!mcp/README.md
!mcp/package.json
deposits
action
# canli-design-system (the Claude Design React wrapper package) and its converter staging
# area: neither ships with the site build.
design-system
.design-sync
.ds-sync
ds-bundle
