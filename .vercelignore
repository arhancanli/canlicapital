# What the deploy uploads is what the build needs, nothing else. On 2026-09-06 the upload hit
# Vercel's 15,000-file cap (15,005) because three agent worktrees under .claude/ and the local
# dist/ rode along, and the landing deploy failed three times. Vercel rebuilds dist/ itself.
.claude
.claude-flow
.env*
.vercel
.git
node_modules
ruvector.db
.bak
.firecrawl
.github
dist
test-results
# Build-time route inventory is required by the reader and release generators.
# Keep every other QA output (especially browser screenshots) out of uploads.
artifacts/qa/*
!artifacts/qa/redesign-scope
artifacts/qa/redesign-scope/*
!artifacts/qa/redesign-scope/inventory.json
# Render sources, reference captures and tool binaries are local authoring inputs.
# Shippable imagery and films already live in public/.
artifacts/generated
artifacts/production
artifacts/reference
artifacts/seo
artifacts/toolchain
artifacts/tooling
docs
supabase
**/*.test.mjs
**/*.test.js
integrations
# mcp/ is a separate package, but the developers page generator reads its README and package.json
# at build time (the assistant block and the published version), so those two stay in the upload.
mcp/*
# The research and fundamentals MCP packages are published to npm on their own; the site never
# imports them. The /developers generator reads each one's package.json, server.json and
# src/server.mjs (name, description, hosted URL, tool names), and the hosted endpoints
# (api/mcp-fundamentals.js, api/mcp-research.js) import src, so those stay in the upload.
mcp-research/*
!mcp-research/package.json
!mcp-research/server.json
!mcp-research/src
mcp-fundamentals/*
!mcp-fundamentals/package.json
!mcp-fundamentals/server.json
!mcp-fundamentals/src
# The local workflow page reads pinned execution source without importing or releasing it.
# Include that documentation input; leave unrelated tests, fixtures and package tooling out.
mcp-execution/*
!mcp-execution/src
!mcp-execution/package.json
!mcp-execution/package-lock.json
!mcp-execution/LICENSE
!mcp-execution/README.md
!mcp-execution/EXAMPLES.md
!mcp-execution/JOURNAL_STORAGE.md
!mcp-execution/examples
mcp-execution/examples/*
!mcp-execution/examples/paper-journal.mjs
!mcp-execution/test
mcp-execution/test/*
!mcp-execution/test/paper-journal-example.test.mjs
!mcp/README.md
!mcp/package.json
!mcp/package-lock.json
!mcp/LICENSE
# The contributor beta endpoint (api/mcp-beta.js) imports the package's working source from
# mcp/src at runtime; /mcp itself serves mcp-released/validation.
!mcp/src
deposits
action
# canli-design-system (the Claude Design React wrapper package) and its converter staging
# area: neither ships with the site build.
design-system
.design-sync
.ds-sync
ds-bundle
# Full-size font sources; the served subsets in public/fonts are generated from them (scripts/fonts/subset-fonts.sh).
fonts-src
