{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.arhancanli/canli-validation-mcp",
  "title": "Canli Validation",
  "description": "Deflated Sharpe and PBO checks. A verdict is not admission to anything and is not a forecast.",
  "websiteUrl": "https://canlicapital.com/developers#ai-assistant",
  "icons": [
    {
      "src": "https://canlicapital.com/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://canlicapital.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/arhancanli/canlicapital",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "canli-validation-mcp",
      "version": "0.9.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CANLI_KEY",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "CANLI_LOCAL",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "CANLI_API_BASE",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://canlicapital.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
