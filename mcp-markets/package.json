{
  "name": "canli-markets-mcp",
  "version": "0.3.0",
  "description": "MCP server for markets, funds and the economy from the sources themselves, no key: options chains and volatility, short interest, dark pools, futures positioning, fund and ETF holdings, 13D/13G, earnings dates and 8-K press-release headlines, segment revenue, executive pay, Form D, the Fed, Treasury auctions, World Bank and OECD macro, screens, filings and prices. Every result cites its sources.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "bin": {
    "canli-markets-mcp": "src/server.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "mcpName": "io.github.arhancanli/canli-markets-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/canlicapital.git",
