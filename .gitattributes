# CommonMark uses two trailing spaces for an intentional hard line break. The
# exported research corpus preserves source bytes and bundle checksums, so Git
# must not treat those semantic spaces (or source-preserved EOF spacing) as a
# patch-hygiene defect.
*.md whitespace=-trailing-space,-blank-at-eof

# Trade-journal vectors are byte-exact test inputs (one has CRLF line ends, one invalid UTF-8):
# never normalise or diff them as text.
standards/trade-journal/vectors/*.jsonl binary
