{
  "name": "canli-mcp",
  "version": "0.12.1",
  "description": "Every Canli Capital MCP server in one: 355 finance tools (SEC filings and XBRL, statements as filed, figures checked against the filings, markets, ownership, options, the Fed and macro, dividends, quant, backtest validation, paper trading) behind five tools in context (2,408 tokens instead of 53,974). Interactive charts, market maps, yield curves, statements, volatility surfaces, stock comparisons, option chains, backtest dashboards with sliders and a paper order ticket in the chat (MCP Apps), firm policy and signed audit log, batch calls, offline mode, local by default.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "bin": {
    "canli-mcp": "src/server.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "src",
    "README.md",
    "FEATURES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"console.log('Plain JavaScript: nothing to build.')\"",
    "build-index": "node scripts/build-index.mjs",
    "test": "node --test test/*.test.mjs test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "canli-backtest-mcp": "0.3.0",
    "canli-fundamentals-mcp": "0.7.2",
    "canli-markets-mcp": "0.8.1",
    "canli-paper-trading-mcp": "0.3.1",
    "canli-quant-mcp": "0.2.0",
    "canli-research-mcp": "0.3.1",
    "canli-validation-mcp": "0.14.1",
    "zod": "4.6.7"
  },
  "mcpName": "io.github.arhancanli/canli-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/canlicapital.git",
    "directory": "mcp-canli"
  },
  "homepage": "https://canlicapital.com/developers",
  "bugs": {
    "url": "https://github.com/arhancanli/canlicapital/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "quant",
    "quantitative-finance",
    "backtesting",
    "overfitting",
    "sec-filings",
    "fundamentals",
    "paper-trading",
    "risk",
    "options",
    "portfolio-optimization",
    "technical-indicators",
    "econometrics",
    "sec-edgar",
    "insider-trading",
    "13f",
    "economic-data",
    "financial-statements",
    "earnings",
    "fact-checking",
    "mcp-apps",
    "esef",
    "central-banks",
    "interest-rates",
    "prediction-markets",
    "defi"
  ],
  "overrides": {
    "canli-backtest-mcp": {
      "canli-validation-mcp": "$canli-validation-mcp"
    },
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
