{
  "name": "canlicapital",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source research and evidence site for Canli Capital and ALPHAC.",
  "author": "Arhan Canli",
  "homepage": "https://canlicapital.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/arhancanli/canlicapital.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "papers": "node scripts/build-papers.mjs",
    "prebuild": "node scripts/build-measurements.mjs && node scripts/build-verify.mjs && node scripts/build-founder.mjs && node scripts/build-methodology.mjs && node scripts/build-papers.mjs",
    "verify": "node scripts/verify-papers.mjs && node scripts/audit-onpage.mjs",
    "audit": "node scripts/audit-onpage.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "measurements": "node scripts/build-measurements.mjs",
    "verify-page": "node scripts/build-verify.mjs",
    "founder-page": "node scripts/build-founder.mjs",
    "methodology-page": "node scripts/build-methodology.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "marked": "^18.0.10",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
