{
  "name": "canlicapital",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source research and evidence site for Canli Capital and ALPHAC.",
  "author": "Arhan Canli",
  "homepage": "https://canlicapital.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/arhancanli/canlicapital.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "papers": "node scripts/build-papers.mjs",
    "prebuild": "node scripts/build-public-claims.mjs && node scripts/build-measurements.mjs && node scripts/build-trials.mjs && node scripts/build-verify.mjs && node scripts/build-papers.mjs && node scripts/build-founder.mjs && node scripts/build-methodology.mjs",
    "verify": "node scripts/build-public-claims.mjs && node scripts/audit-writing.mjs && node scripts/verify-papers.mjs && node scripts/verify-trials.mjs && node scripts/audit-onpage.mjs && node scripts/audit-link-graph.mjs && node scripts/audit-published-numbers.mjs && node scripts/audit-readme.mjs",
    "audit": "node scripts/audit-onpage.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:force": "node scripts/submit-indexnow.mjs --force",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run",
    "test:indexnow": "node --test scripts/submit-indexnow.test.mjs",
    "seo:live-audit": "node scripts/audit-live-seo.mjs",
    "test:seo-audit": "node --test scripts/audit-live-seo.test.mjs",
    "measurements": "node scripts/build-measurements.mjs",
    "trials": "node scripts/build-trials.mjs",
    "verify-page": "node scripts/build-verify.mjs",
    "founder-page": "node scripts/build-founder.mjs",
    "methodology-page": "node scripts/build-methodology.mjs",
    "linkgraph": "node scripts/audit-link-graph.mjs",
    "numbers": "node scripts/audit-published-numbers.mjs",
    "readme": "node scripts/audit-readme.mjs",
    "live-parity": "node scripts/audit-live-evidence.mjs",
    "audit:homepage": "python3 scripts/audit-homepage.py",
    "claims": "node scripts/build-public-claims.mjs",
    "product-contract": "node scripts/audit-product-contract.mjs",
    "writing": "node scripts/audit-writing.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "marked": "^18.0.10",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
}
